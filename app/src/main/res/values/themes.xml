<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose drives the in-app styling; this window theme only sets the
         backdrop and transparent system bars for an edge-to-edge surface. -->
    <style name="Theme.GlitchStudio" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
